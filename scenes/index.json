        ]
      },
      "talk": {
        "opening": [
          {
            "speaker": "",
            "text": "南米、密林の奥。地下に築かれた連邦軍の本部に、川をさかのぼってジオンの部隊が忍び寄る。"
          },
          {
            "speaker": "シャア＝アズナブル",
            "text": "入口さえ見つければこちらのものだ。各機、散開して探せ。"
          },
          {
            "speaker": "あしゅら男爵",
            "text": "フフフ、ジオンと手を組めば連邦の本部などひとひねりよ！"
          },
          {
            "speaker": "兜甲児",
            "text": "あしゅら男爵！ こんなところまで出てきやがって！"
          },
          {
            "speaker": "ボス(マジンガーＺ)",
            "text": "ムハハハ、ボロットもいるだわさ！ 赤いのはオレ様に任せろ！"
          },
          {
            "speaker": "アムロ＝レイ(0079)",
            "text": "赤い機体……やっぱりあの人か。ここは通さない！"
          }
        ],
        "victory": [
          {
            "speaker": "アムロ＝レイ(0079)",
            "text": "基地は守りきった。……でも、あの人はまた来る。"
          }
        ],
        "defeat": [
          {
            "speaker": "シャア＝アズナブル",
            "text": "連邦の本部、いただいたぞ。"
          }
        ]
      },
      "map": "maps/gundam-jaburo.map"
    },
